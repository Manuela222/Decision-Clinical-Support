# Copy this file to backend/.env and fill in your real key.
# backend/.env is gitignored -- it will never be committed.
# Loaded automatically by cds_api.dev_server / cds_api.real_server via
# python-dotenv (does not override a value already exported in your shell).

OPENAI_API_KEY=sk-...

# Optional, defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini
